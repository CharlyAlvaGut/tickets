	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="Tickets (Produccion)"/>
	<parameter name="p_pk_i_ticket" class="java.lang.String">
		<defaultValueExpression><![CDATA["5"]]></defaultValueExpression>
	</parameter>
	<parameter name="p_pk_i_anio" class="java.lang.String">
